# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud STT / TTS Credentials (Path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_service_account.json

# LiveKit Server Configuration (Default is local dev server)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenRouter Configuration (DeepSeek V3 for thinking / reasoning / evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Other LLM providers
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

