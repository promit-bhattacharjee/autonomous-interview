# ==============================================================================
# Dokploy / VPS Production Environment Configuration
# Copy these key-value pairs into the "Environment" tab of your Dokploy Compose Project.
# ==============================================================================

# 1. VPS Host & Networking (CRITICAL for LiveKit WebRTC Audio Streaming)
# Replace with your VPS's actual Public IPv4 Address (e.g. 192.0.2.1)
NODE_IP=YOUR_VPS_PUBLIC_IP

# Public URL used by candidate web browsers to connect to LiveKit WebRTC signaling.
# Option A (Domain with SSL): wss://livekit.yourdomain.com
# Option B (Direct IP/Port): ws://YOUR_VPS_PUBLIC_IP:7880
PUBLIC_LIVEKIT_URL=ws://YOUR_VPS_PUBLIC_IP:7880

# 2. LiveKit Credentials (Matching keys for web_api, langgraph_agent, and livekit-server)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 3. Security & Encryption
# Generate a secure 32+ character random string for student JWT auth session tokens
JWT_SECRET=production-ukvi-jwt-secret-key-32-chars-minimum-entropy-change-this

# 32-byte urlsafe base64 key for SQLite encrypted model vault (AES-GCM / Fernet)
# You can generate a new one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=k2t_9uO8zE1M-1A9_N_v7a4jK0tqL6xW9eP8bX2cR0E=

# 4. LLM & AI Credentials
# OpenRouter API Key (Used by default for DeepSeek V4 Flash thinking, question formulation, and rubric grading)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Gemini Key (Optional / Fallback for STT and alternative models)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other LLM provider keys if BYOK (Bring Your Own Key) is enabled
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# 5. Persistent Storage
DATABASE_URL=sqlite:////data/interview.db
